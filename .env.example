# ─────────────────────────────────────────────────────────────
#  fscart – example environment variables
#  Copy this file to .env and fill in your real values.
# ─────────────────────────────────────────────────────────────

# Application
APP_NAME=fscart
APP_VERSION=1.0.0
ENV=development
DEBUG=true

# Database
# SQLite (default for local development)
DATABASE_URL=sqlite+aiosqlite:///./fscart.db

# PostgreSQL (uncomment for staging / production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/fscart

# Security – change this to a long random string in production!
SECRET_KEY=changeme-use-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS – comma-separated origins
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]
ALLOW_CREDENTIALS=true
ALLOWED_METHODS=["*"]
ALLOWED_HEADERS=["*"]
